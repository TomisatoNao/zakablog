# 坂道博客监控配置
# 复制此文件为 .env 并填入真实值
# .env 文件不应提交到版本控制

# ── 平台开关 ─────────────────────────────────
# QQ_ENABLED=true
# TG_ENABLED=true

# ── QQ Bot ──────────────────────────────────
BOT1_APP_ID=your_app_id_here
BOT1_CLIENT_SECRET=your_secret_here
BOT1_TARGET_OPENID=your_openid_here
# BOT1_HINATA_ENABLED=true   # 是否推送日向坂（默认 true）
# BOT1_NOGI_ENABLED=true     # 是否推送乃木坂
# BOT1_SAKURA_ENABLED=true   # 是否推送樱坂

# Bot 2（可选：如不需要可留空）
BOT2_APP_ID=
BOT2_CLIENT_SECRET=
BOT2_TARGET_OPENID=
# BOT2_HINATA_ENABLED=true
# BOT2_NOGI_ENABLED=true
# BOT2_SAKURA_ENABLED=true

# ── Telegram Bot（一个坂道一个机器人，填相同 token 即共用）─
# 创建 Bot：@BotFather → /newbot → 获取 token
# TG_HINATA_ENABLED=true
# TG_HINATA_BOT_TOKEN=
# TG_HINATA_CHAT_ID=

# TG_NOGI_ENABLED=true
# TG_NOGI_BOT_TOKEN=
# TG_NOGI_CHAT_ID=

# TG_SAKURA_ENABLED=true
# TG_SAKURA_BOT_TOKEN=
# TG_SAKURA_CHAT_ID=
